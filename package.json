{
  "name": "dsh-followup-thread",
  "version": "1.0.0",
  "description": "Ask a follow-up question under any earlier answer and keep the question and answer together, inline, without creating a new conversation in the sidebar.",
  "type": "module",
  "license": "MIT",
  "author": "1T2TTTTT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1T2TTTTT/dsh-followup-thread.git"
  },
  "homepage": "https://github.com/1T2TTTTT/dsh-followup-thread#readme",
  "bugs": {
    "url": "https://github.com/1T2TTTTT/dsh-followup-thread/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "follow-up",
    "thread",
    "conversation"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0 || >=0.2.3-rc.1 <0.3.0-0 || >=0.2.4-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
